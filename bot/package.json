{
  "name": "moneypenny",
  "version": "0.1.0",
  "description": "TeamSpeak music bot (Moneypenny fork) \u2014 local-first + YouTube + LLM control",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @moneypenny/ts6-client",
    "dev": "tsx watch src/index.ts",
    "build": "npm run build -w @moneypenny/ts6-client && npm run build:native && tsc && npm run build:web",
    "build:ts6": "npm run build -w @moneypenny/ts6-client",
    "build:native": "npm run build -w @moneypenny/audio-native",
    "build:native:arm64": "npm run build:arm64 -w @moneypenny/audio-native",
    "build:web": "cd web && npm run build",
    "start": "node dist/index.js",
    "play": "node dist/index.js",
    "test": "vitest run && npm run test -w @moneypenny/ts6-client",
    "test:bot": "vitest run",
    "test:web": "cd web && npm test",
    "test:all": "vitest run && npm run test -w @moneypenny/ts6-client && cd web && npm test",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "check": "npm run lint && npm run build -w @moneypenny/ts6-client && npm run build:native && tsc --noEmit && npm run test:all",
    "scan:tags": "tsx src/tools/library-tag-scan.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22 <27"
  },
  "dependencies": {
    "@honeybbq/teamspeak-client": "0.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@moneypenny/audio-native": "*",
    "@moneypenny/ts6-client": "*",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "music-metadata": "^11.14.0",
    "pino": "^10.3.1",
    "swagger-ui-dist": "^5.32.13",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "tar": "^7.5.22",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.6",
    "@hono/node-server": "^2.1.0",
    "fast-uri": "^3.1.5",
    "hono": "^4.13.2",
    "nanoid": "^3.3.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "better-sqlite3@13.0.3": true
  }
}
