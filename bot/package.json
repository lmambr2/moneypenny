{
  "name": "moneypenny",
  "version": "0.1.0",
  "description": "TeamSpeak music bot (Moneypenny fork) — local-first + YouTube + LLM control",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run build:web",
    "build:web": "cd web && npm run build",
    "start": "node dist/index.js",
    "play": "node dist/index.js",
    "test": "vitest run",
    "test:web": "cd web && npm test",
    "test:all": "vitest run && cd web && npm test",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "check": "npm run lint && tsc --noEmit && npm run test:all",
    "scan:tags": "tsx src/tools/library-tag-scan.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@honeybbq/teamspeak-client": "^0.2.1",
    "axios": "^1.15.3",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.1.1",
    "music-metadata": "^11.12.3",
    "pino": "^10.3.1",
    "ts3-nodejs-library": "^3.5.1",
    "tweetnacl": "^1.0.3",
    "ws": "^8.20.0"
  },
  "overrides": {
    "tar": "^7.5.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
