{
  "name": "moneypenny",
  "version": "0.1.0",
  "description": "TeamSpeak music bot (Moneypenny fork) — local-first + YouTube + LLM control",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @moneypenny/ts6-client",
    "dev": "tsx watch src/index.ts",
    "build": "npm run build -w @moneypenny/ts6-client && npm run build:native || true && tsc && npm run build:web",
    "build:ts6": "npm run build -w @moneypenny/ts6-client",
    "build:native": "npm run build -w @moneypenny/audio-native",
    "build:native:arm64": "npm run build:arm64 -w @moneypenny/audio-native",
    "build:web": "cd web && npm run build",
    "start": "node dist/index.js",
    "play": "node dist/index.js",
    "test": "vitest run && npm run test -w @moneypenny/ts6-client",
    "test:bot": "vitest run",
    "test:web": "cd web && npm test",
    "test:all": "vitest run && npm run test -w @moneypenny/ts6-client && cd web && npm test",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "check": "npm run lint && npm run build -w @moneypenny/ts6-client && tsc --noEmit && npm run test:all",
    "scan:tags": "tsx src/tools/library-tag-scan.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@honeybbq/teamspeak-client": "0.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@moneypenny/audio-native": "*",
    "@moneypenny/ts6-client": "*",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.1.1",
    "music-metadata": "^11.12.3",
    "pino": "^10.3.1",
    "swagger-ui-dist": "^5.32.8",
    "tweetnacl": "^1.0.3",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "tar": "^7.5.21"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
