{
  "name": "moneypenny-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome check --config-path=.. src vite.config.ts vitest.config.ts package.json",
    "lint:fix": "biome check --write --config-path=.. src vite.config.ts vitest.config.ts package.json",
    "format": "biome format --write --config-path=.. src vite.config.ts vitest.config.ts package.json"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "axios": "^1.17.1",
    "pinia": "^4.0.2",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.0.10",
    "sass": "^1.87.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.3.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5"
  }
}
