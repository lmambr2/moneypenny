{
  "name": "@moneypenny/audio-native",
  "version": "0.1.0",
  "description": "Rust N-API Opus, PCM mix/duck, and inbound voice-frame helper",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "napi": {
    "binaryName": "audio-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:arm64": "napi build --platform --release --target aarch64-unknown-linux-gnu",
    "test": "node --test test.cjs",
    "artifacts": "node -e \"const fs=require('fs');console.log(fs.readdirSync('.').filter(f=>f.endsWith('.node')).join('\\n')||'(none)')\""
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^3.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
