{
  "name": "@moneypenny/audio-native",
  "version": "0.1.0",
  "description": "Rust N-API Opus encoder/decoder + energy VAD (PR-B4)",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "napi": {
    "name": "audio-native",
    "triples": {
      "defaults": true,
      "additional": ["aarch64-unknown-linux-gnu"]
    }
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test test.cjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "engines": {
    "node": ">=20"
  }
}
