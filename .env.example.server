# Moneypenny — Server edition defaults (x86_64 + optional NVIDIA)
# Copy over .env after install, or let ./install.sh --edition server write these.
# Full comments: see .env.example

# Edition wiring (docker compose multi-file)
COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml
COMPOSE_PROFILES=core,ollama,rag,voice-server
MONEYPENNY_EDITION=server

# Local fast chat (12B). Do NOT default-pull 31B — enable in Settings
# ("Enable heavy analyst model") only when VRAM allows; see docs/remote-llm.md.
RKLLAMA_URL=http://ollama:11434
RKLLAMA_MODEL=hf.co/unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL

# RAG
VECTOR_DB_URL=http://qdrant:6333
EMBEDDING_URL=http://ollama:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_TIMEOUT_MS=120000

# Server voice — dual-track STT: whisper.cpp (+ Vulkan on AMD) + Piper
STT_URL=http://stt-whisper:9000
TTS_URL=http://piper-tts:8880
STT_MODEL=medium
STT_DEVICE=auto
STT_BACKEND=whisper-cpp
WHISPER_VULKAN=1
# Place ggml-small.bin (etc.) in the whisper-models volume → /models
# STT_MODEL_PATH=/models/ggml-small.bin
# Larger: STT_MODEL=medium or large-v3 when VRAM allows
PIPER_VOICE=en_GB-southern_english_female-low
PIPER_MODEL=/models/en_GB-southern_english_female-low.onnx

MUSIC_DIR=./music

TS6_HOST=
TS6_PORT=9987
TS6_QUERY_HOST=
TS6_QUERY_PORT=10022
TS6_API_KEY=
TS6_SERVER_PASSWORD=
BOT_NAME=Moneypenny
BOT_NICKNAME=Moneypenny
DEFAULT_CHANNEL=
BOT_SESSION_SECRET=change-me-to-a-long-random-string

# If this host only serves LLM for a remote SBC (Topology A), you may run just:
#   COMPOSE_PROFILES=ollama
# and open UFW 11434 from the Pi IP only (docs/remote-llm.md).
