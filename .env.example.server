# Moneypenny — Server edition defaults (x86_64 + AMD GPU)
# Copy over .env after install, or let ./install.sh --edition server write these.
# Full comments: see .env.example
#
# Do NOT put inline "# comments" after a value on the same line.

# Edition wiring (docker compose multi-file)
COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml
COMPOSE_PROFILES=core,rag,voice-server
MONEYPENNY_EDITION=server

# Chat 12B lives on host Ollama penny (:11434). Do not run compose ollama as well
# unless you are on a box without host Ollama. Do NOT default-pull 31B.
RKLLAMA_URL=http://127.0.0.1:11434
RKLLAMA_MODEL=hf.co/unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL

# When the bot is in Docker and Ollama is on the host, use the bridge gateway:
# RKLLAMA_URL=http://172.17.0.1:11434

# Dual-R9700 (after the second card is installed). Until then leave these unset
# so Penny uses the one visible GPU. See docs/gpu-amd.md.
# PENNY_GPU_INDEX=1
# PENNY_RENDER_NODE=/dev/dri/renderD129
# OLLAMA_DESK_URL=http://127.0.0.1:11435
# Settings: llmUrl=:11434 (12B)  llmDelegateUrl=:11435 (31B / coder)

# RAG
VECTOR_DB_URL=http://turbovec:6333
EMBEDDING_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-large-en-v1.5
EMBEDDING_TIMEOUT_MS=120000
RERANKER_URL=
RERANKER_MODEL=bge-reranker-large

# Server voice — whisper.cpp Vulkan + Piper on CPU
STT_URL=http://stt-whisper:9000
TTS_URL=http://piper-tts:8880
STT_MODEL=large-v3-turbo
STT_DEVICE=vulkan
STT_BACKEND=whisper-cpp
WHISPER_VULKAN=1
STT_INITIAL_PROMPT=Moneypenny, skip, pause, resume, volume, INTSUM, AAR, 600i, Colonel, Captain, Talon, hangar, quantum
PIPER_VOICE=en_GB-cori-high
PIPER_MODEL=/models/en_GB-cori-high.onnx

# Optional Kokoro sidecar (CPU). Piper remains fail-open if this is empty.
KOKORO_URL=

# Silero VAD (energy RMS is fallback if the ONNX / onnxruntime-node is missing)
SILERO_VAD_PATH=/models/silero/silero_vad.onnx
SILERO_MODELS_DIR=./models/silero

MUSIC_DIR=./music

TS6_HOST=
TS6_PORT=9987
TS6_QUERY_HOST=
TS6_QUERY_PORT=10022
TS6_API_KEY=
TS6_SERVER_PASSWORD=
BOT_NAME=Moneypenny
BOT_NICKNAME=Moneypenny
DEFAULT_CHANNEL=
BOT_SESSION_SECRET=change-me-to-a-long-random-string
