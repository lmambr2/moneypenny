{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],

  // Renovate is the version-update bot for this repo. There is deliberately no
  // .github/dependabot.yml — running both duplicates every PR. Dependabot
  // SECURITY updates are a separate repo setting that needs no config file and
  // are left ON as a backstop.
  //
  // Renovate over Dependabot for two repo-specific reasons: it can manage npm
  // `overrides` (every remaining advisory here is resolved through one, and
  // Dependabot ignores them outright), and it treats the three package
  // ecosystems as a single queue.
  //
  // Two blind spots no bot covers — keep the CI jobs that do:
  //   * `npm audit` runs as its own CI job. The old `tar` override pinned
  //     BACKWARD onto a vulnerable version while looking like a mitigation.
  //   * `allowScripts` keys are version-pinned, so a native-dep bump silently
  //     stops the addon building. scripts/check-allow-scripts.mjs guards it.

  // Work lands on dev; master trails it by design.
  "baseBranchPatterns": ["dev"],
  "timezone": "America/Denver",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "postUpdateOptions": ["npmDedupe"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  // Security fixes should not wait for the weekly window.
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  },

  "packageRules": [
    // Group low-risk updates so the queue stays readable on a solo repo.
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev dependencies"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["dependencies"],
      "groupName": "production minor and patch"
    },

    // Protocol + credential layer. DESIGN §6.2 requires an exact pin and a
    // source review before any bump — never automated.
    {
      "matchPackageNames": ["@honeybbq/teamspeak-client"],
      "enabled": false
    },

    // better-sqlite3 13 needs Node >= 22. The bot image is node:24-trixie-slim
    // (see bot/Dockerfile); majors are allowed again. keep allowScripts in sync.
    {
      "matchPackageNames": ["better-sqlite3"],
      "matchUpdateTypes": ["major"],
      "enabled": true
    },

    // vue-tsc 3.x cannot load TypeScript 7 — it resolves typescript/lib/tsc.js,
    // which TS 7 no longer exports.
    {
      "matchFileNames": ["bot/web/package.json"],
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },

    // Native addons need their allowScripts key bumped in the same PR or npm
    // silently skips the build and `npm ci` still exits 0.
    {
      "matchPackageNames": [
        "better-sqlite3",
        "@discordjs/opus",
        "esbuild",
        "ffmpeg-static"
      ],
      "addLabels": ["native-addon"],
      "prBodyNotes": [
        ":warning: Native addon. `allowScripts` in the package.json is VERSION-PINNED — update the key to match or npm silently skips the build. CI's check-allow-scripts job fails if they diverge."
      ]
    },

    // Keep SHA-pinned actions fresh.
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
