# Moneypenny Environment — copy to .env and fill
#
# Prefer edition templates when starting fresh:
#   cp .env.example.sbc .env      # Orange Pi / RK3588
#   cp .env.example.server .env   # x86_64
# Or: ./install.sh --edition sbc|server|auto
# Docs: docs/editions.md  RELEASES.md
#
# IMPORTANT: do NOT put inline "# comments" after a value on the same line.
# The compose env_file parser folds a trailing comment into the value when the
# value is empty (e.g. `FOO=   # note` becomes FOO="# note"), silently
# corrupting the setting. Always keep comments on their own lines, like below.

# Edition (written by install.sh)
# MONEYPENNY_EDITION=sbc
# COMPOSE_FILE=docker-compose.yml:docker-compose.sbc.yml
# COMPOSE_PROFILES=core,ollama,rag,voice-edge

# === TeamSpeak 6 Server (existing or new via compose profile) ===
TS6_HOST=teamspeak
TS6_PORT=9987
TS6_QUERY_HOST=teamspeak
# SSH query (TS6)
TS6_QUERY_PORT=10022
# Web query (for API key creation and web UI) is usually on 10080 — make sure
# this port is open on your TS6 server and not firewalled (check ufw on DietPi).
# Access the web UI at http://your-ts-ip:10080 (use an ssh tunnel) to log in as
# serveradmin and create the TS6_API_KEY.
# optional server password (leave empty if none)
TS6_SERVER_PASSWORD=
# TS6 HTTP Query API key (recommended for TS6). Get it from the TS6 web
# interface (http://your-ts-ip:10080): log in as serveradmin (initial password
# is in the TS server logs) and create a key under HTTP Query / API Keys.
# Note: the bundled teamspeak docker image is not arm64 — on ARM (e.g. DietPi)
# use the native ARM TS6 server tarball or point at your existing TS6 server.
TS6_API_KEY=

# File-drop disk mount (co-located TS6 + bot on the same host only).
# On DietPi: TS6_FILES_HOST_DIR=/home/dietpi/teamspeak6/data/files
# and TS6_FILES_DIR=/ts6-files. Skips ftgetfilelist — the watcher reads
# virtualserver_<id>/channel_<cid>/ directly. Remote TS servers: leave unset.
TS6_FILES_HOST_DIR=
TS6_FILES_DIR=
TS6_VIRTUAL_SERVER_ID=1

# Phase 0 convenience: If no bots exist in DB on startup, auto-create one using these.
# This makes quick validation (connect + play audio) very easy.
# Auto !test on connect — prefers local demo copy, else streams default YouTube track.
# Set on production Pi if you want the old startup smoke behaviour without full Phase 0.
PHASE0_AUTO_TEST=0
# Explicit validation track (phase0-validate.sh sets this). Overrides PHASE0_AUTO_TEST.
# Leave empty when using PHASE0_AUTO_TEST only. TS6_HOST alone must NOT trigger playback.
# Example: https://www.youtube.com/watch?v=hLOheGDwD_0  (or a local file in MUSIC_DIR)
PHASE0_TEST_PLAY=
BOT_NAME=Moneypenny
BOT_NICKNAME=Moneypenny
# optional default channel name or ID (use the numeric ID if the name has
# issues; get it from the TS client channel properties). Lobby is the default
# channel on most servers.
DEFAULT_CHANNEL=
# (TS_SERVER_PASSWORD is already set above as TS6_SERVER_PASSWORD)

# Bot auth (web UI + API)
# First account created on first run becomes admin. Do initial setup on localhost.
BOT_WEB_PORT=3000
# Reserved for future cookie signing. Session tokens are randomBytes + SHA-256
# at rest in SQLite (see bot/src/data/sessions.ts) — this value is not required today.
BOT_SESSION_SECRET=change-me-to-a-long-random-string

# Music library — host path bind-mounted to /music inside the bot container.
# install.sh defaults to ./music. Optional override: MUSIC_HOST_DIR (same meaning).
# The bot process always uses MUSIC_DIR=/music via docker-compose (do not set a
# relative path expecting it to work in-container).
MUSIC_DIR=/mnt/music

# Local LLM backend. These are fallbacks — the LLM is normally enabled/configured
# from the web Settings panel (persisted to config.json). Split-brain + analyst
# delegate (llmUrl, llmFallbackUrl, llmDelegateUrl, embeddingUrl) are also in
# config.json only — see docs/remote-llm.md.
#
# Two backends:
#   - Ollama (CPU, x86-64 or ARM): URL http://ollama:11434, model
#     hf.co/unsloth/gemma-4-E2B-it-qat-GGUF:UD-Q4_K_XL (Gemma 4 E2B QAT — native
#     function-calling, ~2.6 GB, ~10 tok/s on RK3588; the default for
#     `--llm ollama`). Bigger box? gemma4:e4b-it-qat is sharper but ~half the speed.
#   - NPU (RK3588 / rkllama): URL http://rkllama:8080, model qwen3-4b-instruct-2507. The NPU
#     runtime only runs Qwen3 W8A8 .rkllm models — it cannot run Gemma GGUFs, and
#     per benchmarks gives no decode speedup over CPU (see ROADMAP).
RKLLAMA_URL=http://ollama:11434
RKLLAMA_MODEL=hf.co/unsloth/gemma-4-E2B-it-qat-GGUF:UD-Q4_K_XL

# Knowledge base / RAG (Phase 5). Enable in the web Settings panel + run the
# `rag` profile (or install with --with-rag). VECTOR_DB_URL → Qdrant. Leave
# EMBEDDING_URL blank to reuse the LLM endpoint (ollama). EMBEDDING_MODEL:
# embeddinggemma (Gemma-family) on Pi and x86.
VECTOR_DB_URL=http://turbovec:6333
EMBEDDING_URL=
EMBEDDING_MODEL=embeddinggemma
# Pi ollama CPU: embeddinggemma is slow (~3 min/batch). Raise if ingest still times out.
EMBEDDING_TIMEOUT_MS=600000

# Compose profiles to auto-start on `docker compose up -d` (comma-separated).
# install.sh writes this; override if you add/remove profiles by hand.
# COMPOSE_PROFILES=core,ollama,rag,voice-edge

# Voice — Whisper dual-track + Piper only (docs/voice-backends.md).
#   voice-edge   — SBC: stt-rknn (NPU) + piper
#   voice-server — x86: stt-whisper-cpp (+ Vulkan on AMD) + piper
#   (sherpa-stt / Kokoro removed — V2)
# Bot Settings:
#   sttUrl=http://stt-whisper:9000
#   ttsUrl=http://piper-tts:8880
#   ttsVoice=en_GB-southern_english_female-low
#   textWakeFallback=true   # required (no KWS on Whisper path)
STT_URL=http://stt-whisper:9000
TTS_URL=http://piper-tts:8880
# SBC (voice-edge): base + rknn + npu  (see .env.example.sbc)
# Server (voice-server): medium + whisper-cpp  (see .env.example.server)
# Installer writes the right trio; these are generic placeholders only.
STT_MODEL=base
STT_DEVICE=npu
STT_BACKEND=rknn
STT_FALLBACK=faster-whisper
# RKNN_MODELS_DIR=/models/rknn
PIPER_VOICE=en_GB-southern_english_female-low
PIPER_MODEL=/models/en_GB-southern_english_female-low.onnx

# Phase 7 MemPalace (compose profile `memory` / install --with-memory).
# Bot Settings still toggle memoryEnabled / mempalaceEnabled / kgEnabled.
# MEMPALACE_URL=http://mempalace-bridge:8090

# ACE-Step music gen (docs/ace-step-host.md) — LAN GPU host, not the Pi.
# Enable aceStepEnabled in Settings; URL can come from env when empty in config.
# ACE_STEP_URL=http://192.168.1.89:7865

# Optional: stream bridge for real Tidal HiFi (Phase 3, DESIGN §7.3). Bring up the
# bundled `tidal-bridge` service (`--profile stream`), do the one-time
# link.tidal.com login (see its logs), then uncomment to stream Tidal links
# directly. Without it, Tidal/Spotify links resolve to YouTube.
# STREAM_BRIDGE_URL=http://tidal-bridge:8081
# Optional per-service overrides (when both Spotify + Tidal bridges run):
# TIDAL_BRIDGE_URL=http://tidal-bridge:8081
# SPOTIFY_BRIDGE_URL=http://spotify-bridge:8082
# TIDAL_QUALITY=LOSSLESS    # LOW | HIGH | LOSSLESS (FLAC) | HI_RES

# === Hardening / ops (DESIGN §11) ===
# Interface the web server binds. Default 127.0.0.1 (localhost-only, safe for
# bare-metal). The Docker image sets 0.0.0.0 since the published port is
# restricted to localhost on the host instead.
# BIND_ADDRESS=127.0.0.1
# Watchdog memory ceiling in MB; on exceed the process exits so Docker's
# restart policy recovers it. 0/unset disables the check.
# WATCHDOG_MEMORY_MB=0
