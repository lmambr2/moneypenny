# Moneypenny Environment — copy to .env and fill
#
# IMPORTANT: do NOT put inline "# comments" after a value on the same line.
# The compose env_file parser folds a trailing comment into the value when the
# value is empty (e.g. `FOO=   # note` becomes FOO="# note"), silently
# corrupting the setting. Always keep comments on their own lines, like below.

# === TeamSpeak 6 Server (existing or new via compose profile) ===
TS6_HOST=teamspeak
TS6_PORT=9987
TS6_QUERY_HOST=teamspeak
# SSH query (TS6)
TS6_QUERY_PORT=10022
# Web query (for API key creation and web UI) is usually on 10080 — make sure
# this port is open on your TS6 server and not firewalled (check ufw on DietPi).
# Access the web UI at http://your-ts-ip:10080 (use an ssh tunnel) to log in as
# serveradmin and create the TS6_API_KEY.
# optional server password (leave empty if none)
TS6_SERVER_PASSWORD=
# TS6 HTTP Query API key (recommended for TS6). Get it from the TS6 web
# interface (http://your-ts-ip:10080): log in as serveradmin (initial password
# is in the TS server logs) and create a key under HTTP Query / API Keys.
# Note: the bundled teamspeak docker image is not arm64 — on ARM (e.g. DietPi)
# use the native ARM TS6 server tarball or point at your existing TS6 server.
TS6_API_KEY=

# Phase 0 convenience: If no bots exist in DB on startup, auto-create one using these.
# This makes quick validation (connect + play audio) very easy.
# Optional auto-play on connect. The default (unset/empty) is the canonical
# Moneypenny unit-test + startup demo track. Example value:
#   https://www.youtube.com/watch?v=dQw4w9WgXcQ   (or a local file in MUSIC_DIR)
PHASE0_TEST_PLAY=
BOT_NAME=Moneypenny
BOT_NICKNAME=Moneypenny
# optional default channel name or ID (use the numeric ID if the name has
# issues; get it from the TS client channel properties). Lobby is the default
# channel on most servers.
DEFAULT_CHANNEL=
# (TS_SERVER_PASSWORD is already set above as TS6_SERVER_PASSWORD)

# Bot auth (web UI + API)
# First account created on first run becomes admin. Do initial setup on localhost.
BOT_WEB_PORT=3000
BOT_SESSION_SECRET=change-me-to-a-long-random-string

# Music library (mounted into bot container)
MUSIC_DIR=/mnt/music

# Local LLM backend. These are fallbacks — the LLM is normally enabled/configured
# from the web Settings panel (persisted to config.json).
#
# Two backends:
#   - Ollama (CPU, x86-64 or ARM): URL http://ollama:11434, model gemma4:e4b-it-qat
#     (Gemma 4 QAT — native function-calling, ~6.1 GB; use gemma4:e2b-it-qat on
#     low-RAM boxes). This is the default for `--llm ollama`.
#   - NPU (RK3588 / rkllama): URL http://rkllama:8080, model qwen3-4b-instruct-2507. The NPU
#     runtime only runs Qwen3 W8A8 .rkllm models — it cannot run Gemma GGUFs.
RKLLAMA_URL=http://ollama:11434
RKLLAMA_MODEL=gemma4:e4b-it-qat

# Phase 2 voice (future)
KOKORO_URL=http://kokoro:8880
# sherpa-onnx runs in-process in the bot for now

# Optional: external Spotify/Tidal stream bridge (Phase 3, DESIGN §7.3)
# STREAM_BRIDGE_URL=http://librespot:1234

# === Hardening / ops (DESIGN §11) ===
# Interface the web server binds. Default 127.0.0.1 (localhost-only, safe for
# bare-metal). The Docker image sets 0.0.0.0 since the published port is
# restricted to localhost on the host instead.
# BIND_ADDRESS=127.0.0.1
# Watchdog memory ceiling in MB; on exceed the process exits so Docker's
# restart policy recovers it. 0/unset disables the check.
# WATCHDOG_MEMORY_MB=0
