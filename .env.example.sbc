# Moneypenny — SBC edition defaults (Orange Pi / RK3588)
# Copy over .env after install, or let ./install.sh --edition sbc write these.
# Full comments: see .env.example

# Edition wiring (docker compose multi-file)
COMPOSE_FILE=docker-compose.yml:docker-compose.sbc.yml
COMPOSE_PROFILES=core,ollama,rag,voice-edge
MONEYPENNY_EDITION=sbc

# On-device fallback LLM (embeddings share this ollama)
RKLLAMA_URL=http://ollama:11434
RKLLAMA_MODEL=hf.co/unsloth/gemma-4-E2B-it-qat-GGUF:UD-Q4_K_XL

# RAG — always on-device for SBC
VECTOR_DB_URL=http://qdrant:6333
EMBEDDING_URL=http://ollama:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_TIMEOUT_MS=600000

# Edge voice — dual-track STT: RKNN (NPU) → faster-whisper CPU fallback + Piper
STT_URL=http://stt-whisper:9000
TTS_URL=http://piper-tts:8880
# small = faster-whisper CPU (RKNN weights today are tiny-only)
STT_MODEL=small
STT_DEVICE=npu
STT_BACKEND=rknn
STT_FALLBACK=faster-whisper
RKNN_MODELS_DIR=/models/rknn
# RKNN_ENCODER=/models/rknn/whisper-tiny-encoder.rknn
# RKNN_DECODER=/models/rknn/whisper-tiny-decoder.rknn
PIPER_VOICE=en_GB-southern_english_female-low
PIPER_MODEL=/models/en_GB-southern_english_female-low.onnx

# Music library (host path → /music in container)
MUSIC_DIR=./music

# TeamSpeak — fill in
TS6_HOST=
TS6_PORT=9987
TS6_QUERY_HOST=
TS6_QUERY_PORT=10022
TS6_API_KEY=
TS6_SERVER_PASSWORD=
BOT_NAME=Moneypenny
BOT_NICKNAME=Moneypenny
DEFAULT_CHANNEL=
BOT_SESSION_SECRET=change-me-to-a-long-random-string

# Split-brain: after install, set in Settings / config.json:
#   llmUrl: http://<server-lan-ip>:11434
#   llmModel: hf.co/unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL
#   llmFallbackUrl: http://ollama:11434
#   embeddingUrl: http://ollama:11434
# See docs/remote-llm.md
