# Dependencies
node_modules/
npm-debug.log*

# Build outputs
dist/
build/
# Rust / N-API workspace crates
**/target/
bot/packages/audio-native/*.node

# Environment & secrets
.env
.env.local
.env.*.local
# Runtime state dirs only — anchored so they don't swallow source dirs like
# bot/src/data/ (an unanchored "data/" did exactly that and broke the build).
/data/
/bot/data/
*.pem
*.key

# ---------------------------------------------------------------------------
# REAL doctrine / RAG corpus — NEVER in the public repo.
# Runtime knowledge base: /bot/data/doctrine/ (under /bot/data/, ignored above).
# Private wiki: separate doctrine.git on the host — not this GitHub tree.
# Public templates only: docs/examples/doctrine/*.example.md (+ README).
# Product how-to: docs/rag-ingestion.md, docs/rag-ingestion-cheatsheet.md
# ---------------------------------------------------------------------------
/doctrine/
/doctrine.private/
/private-doctrine/
/doctrine.local/
/org-doctrine/
/my-doctrine/
**/*.doctrine.local.md
# Examples dir: only *.example.md + README (filled-in copies stay local)
/docs/examples/doctrine/**
!/docs/examples/doctrine/README.md
!/docs/examples/doctrine/*.example.md

# Models (large binaries — never commit weights)
models/**/*.rkllm
models/**/*.rknn
models/**/*.onnx
models/**/*.bin
models/**/*.gguf
models/**/*.safetensors
models/convert/hf/
models/convert/.venv/
models/convert/.venv-rknn2/
models/convert/vendor/
models/npu-llm/**
!models/**/README.md
!models/**/Modelfile
# Allow small RKNN companion text assets
!models/rknn/vocab_en.txt
!models/rknn/mel_80_filters.txt

# Logs & runtime
*.log
logs/
tmp/

# OS / editor
.DS_Store
Thumbs.db
.idea/
# Keep shared Biome/editor recommendations; ignore personal workspace state.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Docker
*.pid

# Python (scripts, voice pipeline)
__pycache__/
*.py[cod]
.venv/
venv/

# Test artifacts
coverage/
.nyc_output/

# Personal quickstart env (real LAN IP) — never commit
phase0.env

# Machine-local Claude settings (never commit)
.claude/
**/.claude/
**/settings.local.json
