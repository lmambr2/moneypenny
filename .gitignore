# Dependencies
node_modules/
npm-debug.log*

# Build outputs
dist/
build/

# Environment & secrets
.env
.env.local
.env.*.local
# Runtime state dirs only — anchored so they don't swallow source dirs like
# bot/src/data/ (an unanchored "data/" did exactly that and broke the build).
/data/
/bot/data/
*.pem
*.key

# ---------------------------------------------------------------------------
# Private org doctrine / logistics — NEVER commit real routes, pads, BOMs.
# Runtime corpus lives under /bot/data/ (ignored above). Templates only:
#   docs/examples/doctrine/*.example.md
# ---------------------------------------------------------------------------
/doctrine.private/
/private-doctrine/
/doctrine.local/
**/*.doctrine.local.md
# Extra trees people invent next to the repo
/org-doctrine/
/my-doctrine/
# Under public doctrine/: only product cheatsheets (e.g. RAG ops). Block the rest.
/doctrine/**
!/doctrine/ops/
/doctrine/ops/**
!/doctrine/ops/rag-ingestion-cheatsheet.md
# Examples dir: only *.example.md + README (filled-in copies stay local)
/docs/examples/doctrine/**
!/docs/examples/doctrine/README.md
!/docs/examples/doctrine/*.example.md

# Models (large binaries — never commit weights)
models/**/*.rkllm
models/**/*.rknn
models/**/*.onnx
models/**/*.bin
models/**/*.gguf
models/**/*.safetensors
models/convert/hf/
models/convert/.venv/
models/convert/.venv-rknn2/
models/convert/vendor/
models/npu-llm/**
!models/**/README.md
!models/**/Modelfile
# Allow small RKNN companion text assets
!models/rknn/vocab_en.txt
!models/rknn/mel_80_filters.txt

# Logs & runtime
*.log
logs/
tmp/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Docker
*.pid

# Python (scripts, voice pipeline)
__pycache__/
*.py[cod]
.venv/
venv/

# Test artifacts
coverage/
.nyc_output/

# Personal quickstart env (real LAN IP) — never commit
phase0.env

# Machine-local Claude settings (never commit)
.claude/
**/.claude/
**/settings.local.json
