{
  "defaultAllow": [
    "play", "add", "queue", "list", "now", "lyrics", "vote", "help",
    "playlist", "album", "prev", "next", "skip", "jump", "go", "pause", "resume",
    "artist", "ask", "test", "roast", "roastout", "roastin", "remember", "recall", "forget", "kg", "diary",
    "ships", "hangar",
    "rate", "unrate", "selecttracks", "radio", "playnext", "pn", "chevron7",
    "mine", "refine", "craft", "econ", "trade", "workorder", "work-items", "workitems",
    "ops"
  ],
  "commandGroups": {
    "admin": [
      "stop", "clear", "move", "moveclient", "moveall", "vol", "mode",
      "follow", "remove", "ban", "unban", "reindex", "ingeststatus", "generate", "ops",
      "mute", "kick", "recording", "workorder.clear", "session",
      "radio.power", "radio.ops", "radio.bumper", "radio.say", "radio.skip", "radio.tags"
    ],
    "analyst": ["analyst", "agent", "intsum", "aar", "ops"],
    "dj": ["stop", "clear", "vol", "mode", "remove", "ban", "unban", "radio.ops", "radio.bumper", "radio.say", "radio.skip", "radio.tags", "generate", "ops"],
    "mod": ["move", "moveclient", "moveall", "follow", "mute", "kick", "session"],
    "doctrine_restricted": ["doctrine:restricted"],
    "doctrine_confidential": ["doctrine:confidential"],
    "doctrine_secret": ["doctrine:secret"]
  },
  "superAdminUids": [],
  "rules": [
    {
      "name": "guest",
      "match": { "serverGroups": ["100"] },
      "deny": ["@analyst", "@admin", "@dj", "@mod"]
    },
    {
      "name": "cadet",
      "match": { "serverGroups": ["101"] },
      "deny": ["@analyst", "@admin", "@mod"]
    },
    {
      "name": "specialist-voice-stop",
      "match": { "serverGroups": ["102"] },
      "allow": ["stop"],
      "scope": "voice"
    },
    {
      "name": "specialist-doctrine-restricted",
      "match": { "serverGroups": ["102"] },
      "allow": ["@doctrine_restricted"]
    },
    {
      "name": "junior-nco-dj",
      "match": { "serverGroups": ["103"] },
      "allow": ["@dj", "@doctrine_restricted"]
    },
    {
      "name": "chief-dj-mod",
      "match": { "serverGroups": ["104"] },
      "allow": ["@dj", "@mod", "@doctrine_restricted", "@doctrine_confidential"]
    },
    {
      "name": "field-grade-officer",
      "match": { "serverGroups": ["105"] },
      "allow": ["@admin", "@doctrine_restricted", "@doctrine_confidential", "@doctrine_secret", "ships.org"]
    },
    {
      "name": "command-staff",
      "match": { "serverGroups": ["106"] },
      "allow": ["@admin", "@analyst", "@doctrine_restricted", "@doctrine_confidential", "@doctrine_secret", "ships.org"]
    },
    {
      "name": "server-admin",
      "match": { "serverGroups": ["107"] },
      "allow": [
        "@admin",
        "@analyst",
        "@doctrine_restricted",
        "@doctrine_confidential",
        "@doctrine_secret",
        "test.skip",
        "ships.org"
      ]
    },
    {
      "name": "staff-tier-a",
      "match": { "serverGroups": ["108"] },
      "allow": ["@admin", "@analyst", "@doctrine_restricted", "@doctrine_confidential", "@doctrine_secret", "ships.org"]
    },
    {
      "name": "staff-tier-b",
      "match": { "serverGroups": ["109"] },
      "allow": ["@admin", "@analyst", "@doctrine_restricted", "@doctrine_confidential", "@doctrine_secret", "ships.org"]
    },
    {
      "name": "department-staff",
      "match": { "serverGroups": ["110", "111", "112", "113", "114"] },
      "allow": ["@doctrine_restricted"]
    }
  ]
}