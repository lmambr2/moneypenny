# Linux datarunner — copy to .env next to the venv. Do not put inline
# comments after values (same compose pitfall as the bot .env.example).

DATARUNNER_DESTINATION=moneypenny
DATARUNNER_SCREENSHOT_DIR=
DATARUNNER_GAME_VERSION=4.10.0
DATARUNNER_ENVIRONMENT=LIVE
DATARUNNER_TERMINAL_ID=
DATARUNNER_TERMINAL_NAME=
DATARUNNER_TYPE=commodity
OCR_DEVICE=auto

MONEYPENNY_INGEST_URL=http://127.0.0.1:3000
MONEYPENNY_INGEST_TOKEN=

UEX_API_BASE=https://api.uexcorp.uk
UEX_API_TOKEN=
UEX_SECRET_KEY=
UEX_IS_PRODUCTION=0
